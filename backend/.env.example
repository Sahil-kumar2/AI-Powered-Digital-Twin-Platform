PORT=3001
NODE_ENV=production
JWT_SECRET=replace-with-strong-secret-min-32-chars

# Get this from neon.tech (free PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI Service URL (from Render after deploying ai-service)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=12000

# Your Vercel frontend URL (add after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app
